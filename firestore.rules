rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Apenas administradores autorizados têm privilégios de gravação/gerenciamento
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email.lower() == 'madscold@gmail.com'
      );
    }

    match /professores/{professorId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /configuracoes/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /avaliacoes_2026/{avaliacaoId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }
    match /presencas/{presencaId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }
    match /rascunhos_avaliacoes_2026/{rascunhoId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
